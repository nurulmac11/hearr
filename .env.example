# Lidarr → Settings → General → API Key
LIDARR_API_KEY=

# Your Plex server's machine identifier. Find it with:
#   curl -s http://<plex-host>:32400/identity
# and copy the machineIdentifier="..." value.
PLEX_SERVER_ID=

# Optional: qBittorrent Web UI password, so "Remove" also deletes the seeding torrent.
QBITTORRENT_PASSWORD=
